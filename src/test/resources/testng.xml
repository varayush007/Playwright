<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Playwright TestNG Suite" parallel="methods" thread-count="3">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="All tests">
        <packages>
            <package name="tests"/>
            <package name="api"/>
        </packages>
    </test>

</suite>